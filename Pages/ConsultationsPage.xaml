<?xml version="1.0" encoding="UTF-8" ?>
<!--
  ═══════════════════════════════════════════════════════════════════════════
  PURPOSE   — "مشاوره‌های من": the consultation hub (pushed detail page with a
              real back-chip/system-back path). Shows both directions (I am the
              client / I am the lawyer) with explicit lifecycle chips, unread
              badges, remaining-time hints and a tap-through into ConsultChatPage.
              Also hosts the lawyer-side shortcuts (my profile status, apply-as-
              lawyer, directory).
  OWNER     — coordinator (premium rebuild: proper scroll layout — header/filters
              fixed, list fills the middle row; tab bar removed since this is a
              pushed page).
  CONSUMES  — IMarketplaceApi.ConsultationsAsync, ITokenStore, IMarketplaceCoordinator.
  PROVIDES  — DI-resolvable page for MarketplaceRoute.Consultations.
  INVARIANTS— server is the only status authority: chips render ConsultationDto.Status
              verbatim; no client-side "paid" flags, no fabricated counts — an empty
              list is a designed empty state.
  ═══════════════════════════════════════════════════════════════════════════
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Vakil_AI_IRAN.Controls"
             x:Class="Vakil_AI_IRAN.Pages.ConsultationsPage"
             Style="{StaticResource PageStyle}"
             NavigationPage.HasNavigationBar="False"
             HideSoftInputOnTapped="True">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- aurora ambience behind everything -->
        <Border Grid.Row="0" Grid.RowSpan="3" WidthRequest="360" HeightRequest="360"
                HorizontalOptions="Start" VerticalOptions="Start" Margin="-110,-130,0,0"
                Background="{StaticResource AuroraIndigoBrush}" StrokeThickness="0"
                StrokeShape="RoundRectangle 180" InputTransparent="True" />
        <Border Grid.Row="0" Grid.RowSpan="3" WidthRequest="300" HeightRequest="300"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-90,-110"
                Background="{StaticResource AuroraVioletBrush}" StrokeThickness="0"
                StrokeShape="RoundRectangle 150" InputTransparent="True" />

        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" MaximumWidthRequest="560"
                             HorizontalOptions="Center" WidthRequest="560" Spacing="0">

            <!-- header: back chip + title + refresh -->
            <Grid Padding="18,16,18,10" ColumnDefinitions="Auto,*,Auto">
                <c:TapBorder x:Name="BackChip" Style="{StaticResource MenuChip}"
                             WidthRequest="48"
                             SemanticProperties.Description="بازگشت"
                             Tapped="OnBackChipTapped">
                    <Image Source="{AppThemeBinding Light=ic_back_dark.png, Dark=ic_back.png}" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </c:TapBorder>
                <Label Grid.Column="1" Text="مشاوره‌های من" FontFamily="VazirmatnBold" FontSize="20"
                       VerticalOptions="Center" Margin="10,0"
                       TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <c:TapBorder Grid.Column="2" x:Name="RefreshChip" Style="{StaticResource MenuChip}"
                             WidthRequest="48"
                             SemanticProperties.Description="تازه‌سازی فهرست"
                             Tapped="OnRefreshChipTapped">
                    <Image Source="ic_refresh.png" WidthRequest="18" HeightRequest="18"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </c:TapBorder>
            </Grid>

            <!-- scope filter strip -->
            <ScrollView Grid.Row="1" Orientation="Horizontal"
                        VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never"
                        HeightRequest="52" Padding="14,4" Margin="0,0,0,4">
                <HorizontalStackLayout x:Name="FilterRow" Spacing="8" />
            </ScrollView>

            <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="Body" Spacing="10" Padding="16,4,16,32">

                    <!-- account block: who am I + lawyer actions -->
                    <Border x:Name="AccountCard" Style="{StaticResource GlassCard}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Style="{StaticResource IconCircle}" VerticalOptions="Center">
                                <Image Source="ic_tab_account_idle.png" WidthRequest="21" HeightRequest="21"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label x:Name="AccountName" Text="…" FontFamily="VazirmatnBold" FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                <HorizontalStackLayout x:Name="AccountMeta" Spacing="6" />
                                <HorizontalStackLayout x:Name="AccountActions" Spacing="8" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- loading / error / content -->
                    <VerticalStackLayout x:Name="LoadingBlock" Spacing="10" IsVisible="False">
                        <ActivityIndicator IsRunning="True" Color="{StaticResource Accent}" HorizontalOptions="Center" Margin="0,26" />
                    </VerticalStackLayout>

                    <Border x:Name="ErrorCard" Style="{StaticResource GlassCard}" IsVisible="False">
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ErrorMessage" Style="{StaticResource Caption}"
                                   HorizontalTextAlignment="Center" />
                            <Button x:Name="RetryBtn" Text="تلاش دوباره" Style="{StaticResource PrimaryBg}"
                                    Clicked="OnRefreshClicked" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout x:Name="EmptyBlock" Spacing="8" IsVisible="False" Margin="0,26">
                        <Image Source="ic_tab_consults_idle.png" WidthRequest="44" HeightRequest="44"
                               HorizontalOptions="Center" />
                        <Label x:Name="EmptyTitle" Text="هنوز مشاوره‌ای شروع نکرده‌اید"
                               FontFamily="VazirmatnBold" FontSize="15" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                        <Label x:Name="EmptyHint" Style="{StaticResource Caption}"
                               Text="از بخش «وکلای متخصص» یک وکیل تأییدشده انتخاب کنید؛ پس از پرداخت، گفتگوی خصوصی اینجا باز می‌شود."
                               HorizontalTextAlignment="Center" />
                        <c:TapBorder x:Name="BrowseLawyersCta" Style="{StaticResource CtaCard}" Margin="0,10,0,0" HeightRequest="48"
                                     SemanticProperties.Description="مشاهده فهرست وکلا"
                                     Tapped="OnBrowseLawyersTapped">
                            <Label Text="مشاهده وکلا" FontFamily="VazirmatnBold" FontSize="15"
                                   TextColor="{StaticResource OnAccent}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </c:TapBorder>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ListBlock" Spacing="10" IsVisible="False" />
                </VerticalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
