<?xml version="1.0" encoding="UTF-8" ?>
<!-- ══════════════════════════════════════════════════════════════════════════
     AuthPage — V1 marketplace entry: signup / login / Google + legacy code.
     OWNER: Agent 10 (UX integration). Visual language copied from
     ActivationPage.xaml (aurora blobs + glass cards + UiMotion entrance).
     Validation messages mirror the server codes in app_module_auth.js.
     ══════════════════════════════════════════════════════════════════════════ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Vakil_AI_IRAN.Controls"
             x:Class="Vakil_AI_IRAN.Pages.AuthPage"
             Style="{StaticResource PageStyle}"
             NavigationPage.HasNavigationBar="False"
             HideSoftInputOnTapped="True">

    <Grid>
        <!-- ───────────── ambient aurora layer (drifts in code-behind) ───────────── -->
        <Border x:Name="AuroraIndigo"
                WidthRequest="380" HeightRequest="380"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="-110,-130,0,0"
                Background="{StaticResource AuroraIndigoBrush}"
                StrokeThickness="0" StrokeShape="RoundRectangle 190"
                InputTransparent="True" />
        <Border x:Name="AuroraViolet"
                WidthRequest="330" HeightRequest="330"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,190,-120,0"
                Background="{StaticResource AuroraVioletBrush}"
                StrokeThickness="0" StrokeShape="RoundRectangle 165"
                InputTransparent="True" />
        <Border x:Name="AuroraGold"
                WidthRequest="300" HeightRequest="300"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,-90,-110"
                Background="{StaticResource AuroraGoldBrush}"
                StrokeThickness="0" StrokeShape="RoundRectangle 150"
                InputTransparent="True" />
        <Border x:Name="AuroraCyan"
                WidthRequest="260" HeightRequest="260"
                HorizontalOptions="Start" VerticalOptions="End"
                Margin="-80,0,0,-90"
                Background="{StaticResource AuroraCyanBrush}"
                StrokeThickness="0" StrokeShape="RoundRectangle 130"
                InputTransparent="True" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="RootStack"
                                 Padding="24,34,24,30"
                                 Spacing="14"
                                 MaximumWidthRequest="540">

                <!-- ── brand ── -->
                <Grid x:Name="LogoHalo" WidthRequest="86" HeightRequest="86" HorizontalOptions="Center">
                    <Border Background="{StaticResource AuroraGoldBrush}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 43"
                            WidthRequest="86" HeightRequest="86"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            InputTransparent="True" />
                    <Border x:Name="LogoDisc"
                            WidthRequest="70" HeightRequest="70"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            Background="{StaticResource HeaderGradientBrush}"
                            Stroke="{StaticResource GoldBrush}" StrokeThickness="1.4"
                            StrokeShape="RoundRectangle 24">
                        <Image Source="ic_emblem.png" WidthRequest="34" HeightRequest="34"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               SemanticProperties.Description="نشان وکیل هوشمند ایران" />
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="HeroBlock" Spacing="4">
                    <Label Text="دفتر وکیل شما"
                           FontFamily="VazirmatnBold" FontSize="23"
                           TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="با حساب وکیل‌جی‌پی مشاوره هوشمند و مشاورهٔ وکیل واقعی را در یک جا داشته باشید."
                           FontFamily="VazirmatnRegular" FontSize="13.5"
                           TextColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- ───────────── segmented tabs ───────────── -->
                <Border x:Name="TabsCard" Style="{StaticResource SegmentBar}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <c:TapBorder x:Name="TabSignup" Style="{StaticResource SegmentTab}"
                                     SemanticProperties.Description="ساخت حساب جدید"
                                     Tapped="OnTabSignupTapped">
                            <Label x:Name="TabSignupLabel"
                                   Text="ساخت حساب جدید"
                                   FontFamily="VazirmatnBold" FontSize="14"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        </c:TapBorder>
                        <c:TapBorder x:Name="TabLogin" Grid.Column="1" Style="{StaticResource SegmentTab}"
                                     SemanticProperties.Description="ورود به حساب"
                                     Tapped="OnTabLoginTapped">
                            <Label x:Name="TabLoginLabel"
                                   Text="ورود"
                                   FontFamily="VazirmatnBold" FontSize="14"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        </c:TapBorder>
                    </Grid>
                </Border>

                <!-- ════════════════ SIGNUP PANEL ════════════════ -->
                <Border x:Name="SignupCard" Style="{StaticResource GlassCard}" Padding="16,16">
                    <VerticalStackLayout Spacing="10">

                        <Border x:Name="NameCard" Style="{StaticResource EntryCard}">
                            <Entry x:Name="NameEntry"
                                   Placeholder="نام نمایشی"
                                   FontSize="15" FontFamily="VazirmatnRegular"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                   Keyboard="Text" MaxLength="40" />
                        </Border>
                        <Label x:Name="NameError" Style="{StaticResource FieldError}" Text="" />

                        <Border x:Name="EmailCard" Style="{StaticResource EntryCard}">
                            <Entry x:Name="EmailEntry"
                                   Placeholder="ایمیل (یا نام کاربری)"
                                   FontSize="15" FontFamily="VazirmatnRegular"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                   Keyboard="Email" MaxLength="254" />
                        </Border>
                        <Label x:Name="EmailError" Style="{StaticResource FieldError}" Text="" />

                        <Border x:Name="UsernameCard" Style="{StaticResource EntryCard}">
                            <Entry x:Name="UsernameEntry"
                                   Placeholder="نام کاربری (اختیاری — حروف کوچک انگلیسی)"
                                   FontSize="15" FontFamily="VazirmatnRegular"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                   Keyboard="Text" MaxLength="20" />
                        </Border>
                        <Label x:Name="UsernameError" Style="{StaticResource FieldError}" Text="" />

                        <Border x:Name="SignupPasswordCard" Style="{StaticResource EntryCard}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                                <Entry x:Name="SignupPasswordEntry"
                                       Placeholder="رمز عبور (حداقل ۸ نویسه)"
                                       FontSize="15" FontFamily="VazirmatnRegular"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                       Keyboard="Text" IsPassword="True" MaxLength="64" />
                                <c:TapBorder x:Name="SignupEyeBtn" Grid.Column="1"
                                             WidthRequest="46" HeightRequest="46"
                                             BackgroundColor="Transparent" StrokeThickness="0"
                                             SemanticProperties.Description="نمایش یا پنهان کردن رمز عبور"
                                             Tapped="OnToggleSignupPassword">
                                    <Image x:Name="SignupEye" Source="ic_eye.png"
                                           WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </c:TapBorder>
                            </Grid>
                        </Border>
                        <Label x:Name="SignupPasswordError" Style="{StaticResource FieldError}" Text="" />

                        <!-- ── role picker: two honest glass cards ── -->
                        <Label Text="نقشه شما در وکیل‌جی‌پی" Style="{StaticResource SectionTitle}" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <c:TapBorder x:Name="RoleClientCard" Style="{StaticResource RoleCard}"
                                         SemanticProperties.Description="نقش موکل: پرسش حقوقی، تنظیم لایحه و رزرو مشاوره"
                                         Tapped="OnRoleClient">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="8">
                                        <Image x:Name="RoleClientTick" Source="ic_check_gold.png" WidthRequest="15" HeightRequest="15"
                                               VerticalOptions="Center" />
                                        <Label Text="من موکل هستم" FontFamily="VazirmatnBold" FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="پرسش حقوقی، تنظیم لایحه و رزرو مشاوره با وکیل"
                                           Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </c:TapBorder>

                            <c:TapBorder x:Name="RoleLawyerCard" Grid.Column="1" Style="{StaticResource RoleCard}"
                                         SemanticProperties.Description="نقش وکیل: پروفایل شما پس از بررسی تیم منتشر می‌شود"
                                         Tapped="OnRoleLawyer">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="8">
                                        <Image x:Name="RoleLawyerTick" Source="ic_radio_off.png" WidthRequest="15" HeightRequest="15"
                                               VerticalOptions="Center" />
                                        <Label Text="من وکیل هستم" FontFamily="VazirmatnBold" FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="پروفایل شما پس از بررسی تیم وکیل‌جی‌پی منتشر می‌شود"
                                           Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </c:TapBorder>
                        </Grid>
                        <Label Text="انتخاب «وکیل» به‌تنهایی تأیید حرفه‌ای نیست؛ نشان «تأییدشده» فقط پس از بررسی تیم صادر می‌شود."
                               Style="{StaticResource Caption}" />

                        <c:TapBorder x:Name="SignupCta" Style="{StaticResource CtaCard}" Margin="0,6,0,0"
                                     SemanticProperties.Description="ساخت حساب و ورود به دفتر"
                                     Tapped="OnSignupClicked">
                            <HorizontalStackLayout x:Name="SignupCtaInner" Spacing="10"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <ActivityIndicator x:Name="SignupBusyRing"
                                                   IsRunning="False" IsVisible="False"
                                                   Color="White" WidthRequest="22" HeightRequest="22"
                                                   VerticalOptions="Center" />
                                <Label x:Name="SignupCtaLabel"
                                       Text="ساخت حساب و ورود به دفتر"
                                       FontFamily="VazirmatnBold" FontSize="16"
                                       TextColor="{StaticResource OnAccent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </c:TapBorder>
                    </VerticalStackLayout>
                </Border>

                <!-- ════════════════ LOGIN PANEL ════════════════ -->
                <Border x:Name="LoginCard" Style="{StaticResource GlassCard}" Padding="16,16" IsVisible="False">
                    <VerticalStackLayout Spacing="10">

                        <Border x:Name="LoginIdentifierCard" Style="{StaticResource EntryCard}">
                            <Entry x:Name="LoginIdentifierEntry"
                                   Placeholder="ایمیل یا نام کاربری"
                                   FontSize="15" FontFamily="VazirmatnRegular"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                   Keyboard="Email" MaxLength="254" />
                        </Border>
                        <Label x:Name="LoginIdentifierError" Style="{StaticResource FieldError}" Text="" />

                        <Border x:Name="LoginPasswordCard" Style="{StaticResource EntryCard}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
                                <Entry x:Name="LoginPasswordEntry"
                                       Placeholder="رمز عبور"
                                       FontSize="15" FontFamily="VazirmatnRegular"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                       Keyboard="Text" IsPassword="True" MaxLength="64" />
                                <c:TapBorder x:Name="LoginEyeBtn" Grid.Column="1"
                                             WidthRequest="46" HeightRequest="46"
                                             BackgroundColor="Transparent" StrokeThickness="0"
                                             SemanticProperties.Description="نمایش یا پنهان کردن رمز عبور"
                                             Tapped="OnToggleLoginPassword">
                                    <Image x:Name="LoginEye" Source="ic_eye.png"
                                           WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </c:TapBorder>
                            </Grid>
                        </Border>
                        <Label x:Name="LoginPasswordError" Style="{StaticResource FieldError}" Text="" />

                        <c:TapBorder x:Name="LoginCta" Style="{StaticResource CtaCard}" Margin="0,6,0,0"
                                     SemanticProperties.Description="ورود به حساب"
                                     Tapped="OnLoginClicked">
                            <HorizontalStackLayout x:Name="LoginCtaInner" Spacing="10"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <ActivityIndicator x:Name="LoginBusyRing"
                                                   IsRunning="False" IsVisible="False"
                                                   Color="White" WidthRequest="22" HeightRequest="22"
                                                   VerticalOptions="Center" />
                                <Label x:Name="LoginCtaLabel"
                                       Text="ورود به حساب"
                                       FontFamily="VazirmatnBold" FontSize="16"
                                       TextColor="{StaticResource OnAccent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </c:TapBorder>

                        <Label Text="رمز خود را فراموش کرده‌اید؟ فعلاً از پشتیبانی وکیل‌جی‌پی بخواهید آن را بازنشانی کند."
                               Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ───────────── shared: status line ───────────── -->
                <Label x:Name="StatusMessage" Style="{StaticResource FormStatus}" Text="" />

                <!-- ───────────── shared: Google ───────────── -->
                <c:TapBorder x:Name="GoogleCard" Style="{StaticResource GhostCard}"
                             SemanticProperties.Description="ادامه با Google"
                             Tapped="OnGoogleClicked">
                    <HorizontalStackLayout x:Name="GoogleInner" Spacing="10"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                        <ActivityIndicator x:Name="GoogleBusyRing"
                                           IsRunning="False" IsVisible="False"
                                           WidthRequest="18" HeightRequest="18"
                                           Color="{StaticResource Accent}" VerticalOptions="Center" />
                        <Label Text="G" FontFamily="VazirmatnBold" FontSize="17"
                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                               VerticalOptions="Center" />
                        <Label Text="ادامه با Google" FontFamily="VazirmatnMedium" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </c:TapBorder>

                <!-- ───────────── shared: legacy activation expander ───────────── -->
                <c:TapBorder x:Name="LegacyHeader" Style="{StaticResource GhostCard}" HeightRequest="48"
                             SemanticProperties.Description="ورود با کد فعال‌سازی نسخه قدیمی"
                             Tapped="OnLegacyToggled">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image x:Name="LegacyChevron" Source="ic_chevron.png" WidthRequest="13" HeightRequest="13"
                               VerticalOptions="Center" />
                        <Label Text="ورود با کد فعال‌سازی (نسخه قدیمی)" Style="{StaticResource LinkLabel}" />
                    </HorizontalStackLayout>
                </c:TapBorder>

                <Border x:Name="LegacyBody" Style="{StaticResource GlassCard}" Padding="14,12" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="اگر نسخهٔ قبلی اپ را با کد کانال استفاده می‌کردید، همان کد اینجا کار می‌کند."
                               Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                        <Border x:Name="LegacyCodeCard" Style="{StaticResource EntryCard}">
                            <Entry x:Name="LegacyCodeEntry"
                                   Placeholder="کد فعال‌سازی"
                                   FontSize="15" FontFamily="VazirmatnRegular"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                   Keyboard="Text" HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource EntryCard}">
                            <Entry x:Name="LegacyNameEntry"
                                   Placeholder="نام شما (اختیاری)"
                                   FontSize="15" FontFamily="VazirmatnRegular"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}"
                                   Keyboard="Text" HorizontalTextAlignment="Center" MaxLength="40" />
                        </Border>
                        <c:TapBorder x:Name="LegacyCta" Style="{StaticResource CtaCard}" HeightRequest="48"
                                     SemanticProperties.Description="ورود با کد فعال‌سازی"
                                     Tapped="OnLegacyActivated">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <ActivityIndicator x:Name="LegacyBusyRing"
                                                   IsRunning="False" IsVisible="False"
                                                   Color="White" WidthRequest="18" HeightRequest="18"
                                                   VerticalOptions="Center" />
                                <Label x:Name="LegacyCtaLabel" Text="ورود با کد"
                                       FontFamily="VazirmatnMedium" FontSize="15"
                                       TextColor="{StaticResource OnAccent}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </c:TapBorder>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,4,0,0">
                    <Image Source="ic_shield.png" WidthRequest="14" HeightRequest="14" />
                    <Label Text="با ساخت حساب، قوانین و مقررات استفاده پذیرفته می‌شود."
                           Style="{StaticResource Caption}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <c:TapBorder x:Name="BackToChatLink" HeightRequest="44" BackgroundColor="Transparent" StrokeThickness="0"
                             Padding="10,4"
                             SemanticProperties.Description="ادامه با دفتر وکیل بدون حساب"
                             Tapped="OnBackToChatTapped">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_chevron.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                        <Label Text="ادامه با دفتر وکیل بدون حساب"
                               Style="{StaticResource LinkLabel}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </c:TapBorder>

                <!-- ───────────── dev panel (DEBUG builds only) ─────────────
                     Visible action that toggles vakil.dev.skipAuth: boot then
                     lands straight on Chat without an account. The whole block
                     is compiled out of release builds (x:Arguments can't do
                     that, so visibility + code paths are both guarded). -->
                <c:TapBorder x:Name="DevSkipAuthRow"
                             Style="{StaticResource GhostCard}"
                             BackgroundColor="Transparent"
                             Stroke="{StaticResource Caution}" StrokeThickness="1"
                             IsVisible="False"
                             SemanticProperties.Description="حالت توسعه: ورود بدون حساب به صفحه اصلی"
                             Tapped="OnToggleSkipAuth">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="ic_settings.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label x:Name="DevSkipAuthLabel" Text="حالت توسعه: ورود بدون حساب"
                               FontFamily="VazirmatnMedium" FontSize="14"
                               TextColor="{StaticResource Caution}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </c:TapBorder>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
