<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <!-- ════════════════════════════════════════════════════════════════════════
         Vakil AI design tokens — "Midnight Chamber" edition (dark-first).

         BRUSH vs COLOR RULE (prevents the MAUI brush→Color crash):
           * Color tokens (no *Brush suffix)  → Color-typed properties ONLY:
               TextColor, BackgroundColor, Stroke-less BoxView.Color, Shell.*Color
           * *Brush tokens                    → Brush-typed properties ONLY:
               Border.Background (via `Background`), Border.Stroke, Shape.Fill
         Never feed a *Brush into a Color-typed property or Setter target.

         Light/dark surfaces pair through AppThemeBinding, e.g.
           BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- semantic -->
    <Color x:Key="Caution">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="Success">#10B981</Color>
    <!-- theme-tuned text variants: the raw semantic colors fail WCAG AA as small
         text on their opposite theme's surfaces (e.g. #EF4444 ≈ 3.3:1 on light).
         Use *Ink tokens for text, the raw ones for fills/strokes only. -->
    <Color x:Key="DangerInkLight">#B91C1C</Color>
    <Color x:Key="DangerInkDark">#F87171</Color>
    <Color x:Key="SuccessInkLight">#047857</Color>
    <Color x:Key="SuccessInkDark">#34D399</Color>
    <Color x:Key="Gold">#D4AF37</Color>
    <Color x:Key="GoldSoft">#F8E7A1</Color>
    <Color x:Key="Violet">#8B5CF6</Color>
    <Color x:Key="Cyan">#22D3EE</Color>

    <!-- dark surfaces -->
    <Color x:Key="SurfaceDark">#0B1220</Color>
    <Color x:Key="SurfaceDarkAlt">#111C2E</Color>
    <Color x:Key="ComposerDark">#0E1728</Color>
    <Color x:Key="HairlineDark">#1E2C42</Color>
    <Color x:Key="BubbleUser">#1D4ED8</Color>
    <Color x:Key="BubbleAssistant">#111C2E</Color>
    <Color x:Key="InkDark">#E6EDF7</Color>
    <Color x:Key="InkMuted">#94A3B8</Color>
    <Color x:Key="Accent">#6366F1</Color>
    <Color x:Key="AccentSoft">#818CF8</Color>
    <Color x:Key="AccentDeep">#4338CA</Color>
    <Color x:Key="QuoteBar">#334155</Color>
    <Color x:Key="Overlay">#80000000</Color>
    <Color x:Key="CodeBackground">#0D1117</Color>
    <Color x:Key="CodeInk">#A5D6FF</Color>

    <!-- light surfaces -->
    <Color x:Key="SurfaceLight">#EEF2FA</Color>
    <Color x:Key="SurfaceLightAlt">#FFFFFF</Color>
    <Color x:Key="ComposerLight">#F4F6FB</Color>
    <Color x:Key="HairlineLight">#CBD5E1</Color>
    <Color x:Key="BubbleUserLight">#2563EB</Color>
    <Color x:Key="BubbleAssistantLight">#FFFFFF</Color>
    <Color x:Key="InkLight">#0B1220</Color>
    <Color x:Key="InkMutedLight">#5B6B82</Color>
    <Color x:Key="AccentLight">#4F46E5</Color>
    <Color x:Key="QuoteBarLight">#CBD5E1</Color>
    <Color x:Key="OverlayLight">#33000000</Color>

    <!-- elevation / components -->
    <Color x:Key="SurfaceElevatedDark">#141F33</Color>
    <Color x:Key="ComposerFieldDark">#1A2740</Color>
    <Color x:Key="FeatureCardDark">#0F1B2E</Color>
    <Color x:Key="GlassDark">#1A2438</Color>
    <Color x:Key="GlassLight">#F7F9FE</Color>

    <!-- header / brand gradient stops -->
    <Color x:Key="HeaderStart">#312E81</Color>
    <Color x:Key="HeaderMid">#1E1B4B</Color>
    <Color x:Key="HeaderEnd">#0B1220</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="SoftDanger">#2A1620</Color>
    <Color x:Key="SoftSuccess">#0F2A21</Color>

    <!-- component-level stroke/fill pairs (used inside AppThemeBinding — literal
         hex strings inside a markup extension are NOT converted, tokens are) -->
    <Color x:Key="BubbleUserStrokeLight">#1E40AF</Color>
    <Color x:Key="BubbleUserStrokeDark">#6366F1</Color>
    <Color x:Key="IconStrokeLight">#B4C2D9</Color>
    <Color x:Key="IconStrokeDark">#27395C</Color>
    <Color x:Key="GlassStrokeLight">#88FFFFFF</Color>
    <Color x:Key="GlassStrokeDark">#226366F1</Color>
    <Color x:Key="PlateFillLight">#EEF2FF</Color>
    <Color x:Key="PlateFillDark">#16233D</Color>
    <Color x:Key="PlateStrokeLight">#DDE3FF</Color>
    <Color x:Key="PlateStrokeDark">#27395C</Color>

    <!-- ──────────────────────── gradient brushes (Brush props ONLY) ──────────────────────── -->

    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GoldSoft}" Offset="0" />
        <GradientStop Color="{StaticResource Gold}" Offset="0.5" />
        <GradientStop Color="#9A741C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource HeaderStart}" Offset="0" />
        <GradientStop Color="{StaticResource HeaderMid}" Offset="0.55" />
        <GradientStop Color="{StaticResource HeaderEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CtaBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#4338CA" Offset="0.55" />
        <GradientStop Color="#312E81" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#33FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AuroraIndigoBrush" Center="0.5,0.5" Radius="0.65">
        <GradientStop Color="#4C6366F1" Offset="0" />
        <GradientStop Color="#006366F1" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AuroraVioletBrush" Center="0.5,0.5" Radius="0.65">
        <GradientStop Color="#408B5CF6" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AuroraGoldBrush" Center="0.5,0.5" Radius="0.65">
        <GradientStop Color="#2ED4AF37" Offset="0" />
        <GradientStop Color="#00D4AF37" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="AuroraCyanBrush" Center="0.5,0.5" Radius="0.65">
        <GradientStop Color="#3322D3EE" Offset="0" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </RadialGradientBrush>

    <!-- ──────────────────────── global Persian typography ──────────────────────── -->

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="VazirmatnMedium" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style TargetType="Image">
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Page chrome -->
    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>

    <!-- ──────────────────────── chat bubbles ────────────────────────
         RTL note: Start renders on the RIGHT (user side), End renders on the LEFT. -->
    <Style x:Key="ChatBubble" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BubbleAssistantLight}, Dark={StaticResource BubbleAssistant}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="15,11" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="MaximumWidthRequest" Value="480" />
        <Setter Property="Shadow">
            <Shadow Radius="18" Offset="0,6" Opacity="0.32">
                <Shadow.Brush>
                    <SolidColorBrush Color="#66000000" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="20,6,20,20" />
        </Setter>
    </Style>

    <Style x:Key="UserBubble" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UserBubbleBrush}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BubbleUserStrokeLight}, Dark={StaticResource BubbleUserStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="15,11" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="MaximumWidthRequest" Value="480" />
        <Setter Property="Shadow">
            <Shadow Radius="20" Offset="0,7" Opacity="0.45">
                <Shadow.Brush>
                    <SolidColorBrush Color="#771D4ED8" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="6,20,20,20" />
        </Setter>
    </Style>

    <!-- ──────────────────────── header ──────────────────────── -->
    <Style x:Key="HeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HeaderGradientBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow">
            <Shadow Radius="20" Offset="0,8" Opacity="0.5">
                <Shadow.Brush>
                    <SolidColorBrush Color="#66000000" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="0,0,28,28" />
        </Setter>
    </Style>

    <Style x:Key="QuotaChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#33FFFFFF" />
        <Setter Property="Stroke" Value="#55FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="16" />
        </Setter>
    </Style>

    <Style x:Key="HeaderTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
    </Style>

    <Style x:Key="HeaderSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="#C7D2FE" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}" />
    </Style>

    <!-- ──────────────────────── composer ──────────────────────── -->
    <Style x:Key="ComposerBar" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ComposerLight}, Dark={StaticResource ComposerDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <!-- No Shadow: on Android a blurred elevation behind a live Editor
             re-renders every keyboard frame and made the composer "load" with
             visible jank/blank moments. A hairline stroke + distinct surface
             reads as elevation without the per-frame blur cost. -->
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="26,26,0,0" />
        </Setter>
    </Style>

    <Style x:Key="ComposerEditor" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InkMutedLight}, Dark={StaticResource InkMuted}}" />
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="MaximumHeightRequest" Value="120" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style x:Key="IconCircle" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource ComposerFieldDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource IconStrokeLight}, Dark={StaticResource IconStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="23" />
        </Setter>
    </Style>

    <!-- gradient send disc: Border + Brush (Button.BackgroundColor cannot take a brush) -->
    <Style x:Key="SendCircle" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="Background" Value="{StaticResource CtaBrush}" />
        <Setter Property="Stroke" Value="#66FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Shadow">
            <Shadow Radius="14" Offset="0,4" Opacity="0.5">
                <Shadow.Brush>
                    <SolidColorBrush Color="#774338CA" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="23" />
        </Setter>
    </Style>

    <!-- full-width gradient CTA (activation) -->
    <Style x:Key="CtaCard" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="Background" Value="{StaticResource CtaBrush}" />
        <Setter Property="Stroke" Value="#44FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Shadow">
            <Shadow Radius="22" Offset="0,10" Opacity="0.5">
                <Shadow.Brush>
                    <SolidColorBrush Color="#884338CA" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <!-- big gradient CTA button kept as Button style for quick-action rows -->
    <Style x:Key="SendButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontFamily" Value="VazirmatnBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- ──────────────────────── cards ──────────────────────── -->
    <Style x:Key="EntryCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLightAlt}, Dark={StaticResource SurfaceDarkAlt}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="16" />
        </Setter>
    </Style>

    <Style x:Key="FeatureCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource FeatureCardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Shadow">
            <Shadow Radius="16" Offset="0,5" Opacity="0.28">
                <Shadow.Brush>
                    <SolidColorBrush Color="#55000000" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <!-- frosted feature card (hero pages) -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource GlassDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Shadow">
            <Shadow Radius="22" Offset="0,8" Opacity="0.3">
                <Shadow.Brush>
                    <SolidColorBrush Color="#66000000" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="20" />
        </Setter>
    </Style>

    <!-- horizontal quick-menu chip — 40 visual height, 44dp TOUCH floor via
         MinimumHeightRequest (TapBorder raises it too; plain Borders here stay
         hit-testable because the strip padding gives room). -->
    <Style x:Key="MenuChip" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLightAlt}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="20" />
        </Setter>
    </Style>

    <!-- icon plate inside feature cards -->
    <Style x:Key="IconPlate" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PlateFillLight}, Dark={StaticResource PlateFillDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PlateStrokeLight}, Dark={StaticResource PlateStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="13" />
        </Setter>
    </Style>

    <!-- ──────────────────────── action buttons ──────────────────────── -->
    <Style x:Key="PrimaryBg" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontFamily" Value="VazirmatnMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="SuccessBg" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Success}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontFamily" Value="VazirmatnMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="DangerBg" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontFamily" Value="VazirmatnMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         ADDITIVE (Agent 10 — AuthPage + ConsultChatPage). Existing tokens and
         styles above are untouched; selection/error states are driven from
         code-behind (Stroke/BackgroundColor), so these styles only carry the
         neutral resting look.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- segmented auth tabs container (ساخت حساب / ورود) -->
    <Style x:Key="SegmentBar" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark=#22304A}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <!-- one segment inside SegmentBar (selected look set in code) — 44dp floor -->
    <Style x:Key="SegmentTab" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10,11" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="14" />
        </Setter>
    </Style>

    <!-- selectable role card (من موکل / من وکیل) — selected look set in code -->
    <Style x:Key="RoleCard" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource GlassDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource GlassStrokeLight}, Dark={StaticResource GlassStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="13,12" />
        <Setter Property="Shadow">
            <Shadow Radius="18" Offset="0,7" Opacity="0.26">
                <Shadow.Brush>
                    <SolidColorBrush Color="#66000000" />
                </Shadow.Brush>
            </Shadow>
        </Setter>
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <!-- quiet glass action row (Google, legacy-code expander header) -->
    <Style x:Key="GhostCard" TargetType="Border" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="16" />
        </Setter>
    </Style>

    <!-- inline field validation message (error look) — theme-tuned ink for AA contrast -->
    <Style x:Key="FieldError" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnRegular" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerInkLight}, Dark={StaticResource DangerInkDark}}" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- form-level status line (error / success) — color set in code via FormStatusInk -->
    <Style x:Key="FormStatus" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerInkLight}, Dark={StaticResource DangerInkDark}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- consultation status chip (colour set per state in code-behind) -->
    <Style x:Key="MetaChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GlassLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <shapes:RoundRectangle CornerRadius="14" />
        </Setter>
    </Style>

    <!-- page-back text button (NavigationPage-free shell uses these) -->
    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentSoft}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="VazirmatnBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    </Style>

</ResourceDictionary>
